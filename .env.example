# Copie para .env e ajuste. NUNCA versione o arquivo .env.
NODE_ENV=development
LOG_LEVEL=info
HOST=127.0.0.1
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=BaseEscolas
DB_USER=app
DB_PASSWORD=app_local_password
DB_ROOT_PASSWORD=root_local_password
DB_SSL=false
DB_POOL_MAX=5
DB_LOGGING=false

# https://suporte-t.schoolguardian.app — deixe vazio até ter o banco de hom
HOM_DB_HOST=
HOM_DB_PORT=3306
HOM_DB_NAME=BaseEscolas
HOM_DB_USER=
HOM_DB_PASSWORD=
HOM_DB_SSL=true

# https://suporte.schoolguardian.app — em produção, vazio usa DB_* acima
PROD_DB_HOST=
PROD_DB_PORT=3306
PROD_DB_NAME=BaseEscolas
PROD_DB_USER=
PROD_DB_PASSWORD=
PROD_DB_SSL=true

# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troque-por-um-segredo-aleatorio-com-no-minimo-32-caracteres
JWT_ISSUER=school-guardian-support
JWT_AUDIENCE=school-guardian-support-api
JWT_EXPIRES_IN_SECONDS=600
SESSION_MAX_AGE_SECONDS=28800

# Origens separadas por vírgula (vazio = CORS desabilitado)
CORS_ORIGINS=http://localhost:5173,https://suporte.schoolguardian.app,https://suporte-t.schoolguardian.app
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5

# Imagens de ticket. No local deixe o bucket vazio: o arquivo fica em disco e a URL não é assinada.
# Em hom/prod use o mesmo bucket privado e a mesma URL do CMS (fotos de aluno). A API assina por 30 minutos na leitura.
# Na Lambda a assinatura usa o papel da função. AWS_S3_KEY e AWS_S3_SECRET só fazem falta fora da AWS.
AWS_S3_BUCKET=
AWS_S3_REGION=us-west-2
AWS_S3_URL=https://d2j2x01e904yhl.cloudfront.net/
AWS_S3_KEY=
AWS_S3_SECRET=

# Usado apenas por `npm run db:seed:admin`
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@schoolguardian.local
ADMIN_LOGIN=admin
ADMIN_PASSWORD=troque-esta-senha-forte
